<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="camera_link">
  
  <visual>
    <geometry>
      <box size="${camera_length} ${camera_width} ${camera_height}"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="${camera_length} ${camera_width} ${camera_height}"/>
    </geometry>
  </collision>
  <xacro:box_inertia mass="${camera_mass}" x="${camera_length}" y="${camera_width}" z="${camera_height}" />
</link>

<joint name="camera_joint" type="fixed">
  <origin xyz="${laser_length/2 + camera_length/2 } 0.0 ${laser_height/2 + camera_height /2}"/>
  <parent link="laser_link"/>
  <child link="camera_link"/>
</joint>


<gazebo reference="camera_link">
  <sensor name="camera" type="camera">
    <topic>camera/image_raw</topic>
    <update_rate>30</update_rate>
    <always_on>true</always_on>
    <gz_frame_id>camera_link</gz_frame_id>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>15.0</far>
      </clip>
    </camera>
  </sensor>
</gazebo>




<link name="laser_link">
  
  <visual>
    <geometry>
      <box size="${laser_length} ${laser_width} ${laser_height}"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="${laser_length} ${laser_width} ${laser_height}"/>
    </geometry>
  </collision>
  <xacro:box_inertia mass="${laser_mass}" x="${laser_length}" y="${laser_width}" z="${laser_height}" />
</link>

<joint name="laser_joint" type="fixed">
  <origin xyz="${body_length/2 + laser_length/2} 0.0 ${body_height/2 + laser_height/2}"/>
  <parent link="base_link"/>
  <child link="laser_link"/>
</joint>



<gazebo reference="laser_link">
  <sensor name="laser" type="gpu_lidar">
    <topic>scan</topic>
    <gz_frame_id>laser_link</gz_frame_id>
    <update_rate>10</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>705</samples>
          <resolution>1</resolution>
          <min_angle>-2.4</min_angle>
          <max_angle>2.4</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.05</min>
        <max>9.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
  </sensor>
</gazebo>



<link name="imu_link">
  <xacro:box_inertia mass="0.05" x="0.02" y="0.02" z="0.01"/>
</link>

<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0 0 0"/>
</joint>



<gazebo reference="imu_link">
  <sensor name="imu" type="imu">
    <topic>imu</topic>
    <update_rate>100</update_rate>
    <always_on>true</always_on>
    <gz_frame_id>imu_link</gz_frame_id>
  </sensor>
</gazebo>

</robot>