<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="warehouse_rover">

<xacro:macro name="caster_wheel" params="prefix *origin">
  <link name="${prefix}">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/MP-400-CASTER-WHEEL.dae"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="${prefix}_joint" type="fixed">
    <parent link="base_link"/>
    <child link="${prefix}"/>
    <xacro:insert_block name="origin"/>
  </joint>
</xacro:macro>




<link name="base_footprint"/>


<joint name="base_footprint_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0.0 0.002" />
  
</joint>



  <link name="base_link">
    <visual>
    <origin rpy="0 0 1.57" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/MP-400-BODY.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

<link name="left_wheel">
  <visual>
  <origin rpy="0 0 0" xyz="0 0 0"/>
    <geometry>
      <mesh filename="package://rover_description/meshes/MP-400-FIXED-WHEEL-LEFT.dae"
            scale="0.001 0.001 0.001"/>
    </geometry>
  </visual>
</link>

<joint name="left_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="left_wheel"/>
  <origin xyz="0 0.26 0.074" rpy="0 0 1.57"/>
  <axis xyz="-1 0 0"/>
</joint>


<link name="right_wheel">
  <visual>
  <origin rpy="0 0 3.14" xyz="0 0 0"/>
    <geometry>
      <mesh filename="package://rover_description/meshes/MP-400-FIXED-WHEEL-RIGHT.dae"
            scale="0.001 0.001 0.001"/>
    </geometry>
  </visual>
</link>

<joint name="right_wheel_joint" type="continuous">
  <parent link="base_link"/>
  <child link="right_wheel"/>
  <origin xyz="0 -0.26 0.074" rpy="0 0 1.57"/>
  <axis xyz="-1 0 0"/>
</joint>



<xacro:caster_wheel prefix="caster_front_left">
  <origin xyz="0.165 0.155 0.036" rpy="0 0 1.57"/>
</xacro:caster_wheel>


<xacro:caster_wheel prefix="caster_rear_left">
  <origin xyz="-0.220 0.155 0.036" rpy="0 0 1.57"/>
</xacro:caster_wheel>

<xacro:caster_wheel prefix="caster_front_right">
  <origin xyz="0.165 -0.155 0.036" rpy="0 0 1.57"/>
</xacro:caster_wheel>


  <xacro:caster_wheel prefix="caster_rear_right">
  <origin xyz="-0.220 -0.155 0.036" rpy="0 0 1.57"/>
</xacro:caster_wheel>

</robot>