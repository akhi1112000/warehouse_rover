<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="warehouse_rover">

<xacro:include filename="$(find rover_description)/urdf/properties.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/inertia_macros.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/base.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/wheels.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/ros2_control.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/caster_wheels.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/gazebo_links.xacro"/>
<xacro:include filename="$(find rover_description)/urdf/gazebo_plugins.xacro"/>


</robot>