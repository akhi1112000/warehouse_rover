<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="warehouse">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>



    <!--1 left walls-->

    <model name="wall_north">
  <static>true</static>
  <pose>0 10 1 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry>
        <box><size>20 0.2 2</size></box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box><size>20 0.2 2</size></box>
      </geometry>
    </visual>
  </link>
</model>



<model name="wall_south">
  <static>true</static>
  <pose>0 -10 1 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry>
        <box><size>20 0.2 2</size></box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box><size>20 0.2 2</size></box>
      </geometry>
    </visual>
  </link>
</model>


<model name="wall_east">
  <static>true</static>
  <pose>10 0 1 0 0 1.57</pose>
  <link name="link">
    <collision name="collision">
      <geometry>
        <box><size>20 0.2 2</size></box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box><size>20 0.2 2</size></box>
      </geometry>
    </visual>
  </link>
</model>


<model name="wall_west">
  <static>true</static>
  <pose>-10 0 1 0 0 1.57</pose>
  <link name="link">
    <collision name="collision">
      <geometry>
        <box><size>20 0.2 2</size></box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box><size>20 0.2 2</size></box>
      </geometry>
    </visual>
  </link>
</model>

<include>
  <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
  <name>shelf_row_1</name>
  <pose>0 -4.30 0 0 0 0</pose>
</include>

<include>
  <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
  <name>shelf_row_2</name>
  <pose>0 -2.15 0 0 0 0</pose>
</include>

<include>
  <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
  <name>shelf_row_3</name>
  <pose>0 0 0 0 0 0</pose>
</include>

<include>
  <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
  <name>shelf_row_4</name>
  <pose>0 2.15 0 0 0 0</pose>
</include>

<include>
  <uri>https://fuel.gazebosim.org/1.0/MovAi/models/shelf</uri>
  <name>shelf_row_5</name>
  <pose>0 4.30 0 0 0 0</pose>
</include>



  </world>
</sdf>
